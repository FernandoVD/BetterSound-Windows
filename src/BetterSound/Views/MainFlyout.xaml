<Window x:Class="BetterSound.Views.MainFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:audio="clr-namespace:BetterSound.Audio"
        Title="BetterSound"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="300"
        Topmost="True"
        Deactivated="Window_Deactivated">

    <Border Background="{DynamicResource FlyoutBackgroundBrush}"
            BorderBrush="{DynamicResource FlyoutBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.3" Color="Black" />
        </Border.Effect>

        <StackPanel>

            <!-- Sound -->
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Sound" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource IconGlyphButtonStyle}"
                            Content="{Binding Audio.MuteGlyph}"
                            IsEnabled="{Binding Audio.SupportsMasterVolume}"
                            Click="MasterMuteButton_Click" />
                    <Slider Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource PillSliderStyle}"
                            Value="{Binding Audio.EffectiveMasterVolume, Mode=TwoWay}"
                            IsEnabled="{Binding Audio.SupportsMasterVolume}" />
                </Grid>
                <TextBlock Text="No single volume control for this output" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0"
                           Visibility="{Binding Audio.SupportsMasterVolume, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
            </StackPanel>

            <!-- Output -->
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Output" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource IconBrush}" Text="{Binding Audio.CurrentOutputGlyph}"
                               VerticalAlignment="Center" Width="18" />
                    <TextBlock Grid.Column="1" Text="{Binding Audio.CurrentOutputName}" Style="{StaticResource BodyTextStyle}"
                               Margin="8,0" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource IconGlyphButtonStyle}" Content="&#xE70D;"
                            FontSize="10" Click="OutputDeviceButton_Click" />
                </Grid>
            </StackPanel>

            <!-- Input -->
            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Input" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource IconGlyphButtonStyle}"
                            Content="{Binding Audio.InputMuteGlyph}"
                            IsEnabled="{Binding Audio.SupportsInputVolume}"
                            Click="InputMuteButton_Click" />
                    <Slider Grid.Column="1" Margin="8,0" Style="{StaticResource PillSliderStyle}"
                            Value="{Binding Audio.EffectiveInputVolume, Mode=TwoWay}"
                            IsEnabled="{Binding Audio.SupportsInputVolume}" />
                    <Button Grid.Column="2" Style="{StaticResource IconGlyphButtonStyle}" Content="&#xE70D;"
                            FontSize="10" Click="InputDeviceButton_Click" />
                </Grid>
            </StackPanel>

            <!-- Applications: icon + slider only, matching the native Volume
                 mixer's own minimal per-app rows (no name label, no separate
                 mute button — the app name is a tooltip instead). -->
            <StackPanel Margin="0,0,0,18" Visibility="{Binding Apps.Items.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <TextBlock Text="Applications" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding Apps.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type audio:AppAudioItem}">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding Icon}" Width="20" Height="20" Cursor="Hand"
                                       Opacity="{Binding IsMuted, Converter={StaticResource MutedOpacityConverter}}"
                                       MouseLeftButtonDown="AppIcon_MouseLeftButtonDown"
                                       ToolTip="{Binding Name}" />
                                <Slider Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource PillSliderSmallStyle}"
                                        Value="{Binding EffectiveVolume, Mode=TwoWay}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Update available -->
            <StackPanel Margin="0,0,0,10" Visibility="{Binding Updates.AvailableUpdate, Converter={StaticResource NullToVisibilityConverter}}">
                <TextBlock Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">
                    <Hyperlink NavigateUri="{Binding Updates.AvailableUpdate.HtmlUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="Update available: v" /><Run Text="{Binding Updates.AvailableUpdate.Version, Mode=OneWay}" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <Button Content="BetterSound Settings…" Style="{StaticResource LinkButtonStyle}" Click="SettingsButton_Click" />

        </StackPanel>
    </Border>
</Window>
