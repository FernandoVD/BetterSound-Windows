<Window x:Class="BetterSound.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About BetterSound"
        Width="320" Height="260"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource FlyoutBackgroundBrush}">
    <StackPanel Margin="24" VerticalAlignment="Center">
        <TextBlock Text="BetterSound" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Center" FontSize="20" />
        <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,16" />
        <TextBlock Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16">
            A tiny, open-source Windows equivalent of a Control Center–style sound mixer: master volume, device switching, and per-app volume — right from the tray.
        </TextBlock>
        <TextBlock Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center">
            <Run Text="Windows port of " /><Hyperlink NavigateUri="https://github.com/FernandoVD/BetterSound" RequestNavigate="Hyperlink_RequestNavigate"><Run Text="BetterSound for macOS" /></Hyperlink>
        </TextBlock>
        <TextBlock Text="MIT License · © 2026 FernandoVD" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" Margin="0,8,0,0" />
    </StackPanel>
</Window>
