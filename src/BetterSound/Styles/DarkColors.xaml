<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="#2C2C2C" Opacity="0.92" />
    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#FFFFFF17" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C5C5C5" />
    <SolidColorBrush x:Key="DividerBrush" Color="#FFFFFF17" />
    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="TrackBackgroundBrush" Color="#FFFFFF1F" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FFFFFF12" />
    <SolidColorBrush x:Key="IconBrush" Color="#FFFFFF" />

    <FontFamily x:Key="UIFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
