<Application x:Class="BetterSound.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BetterSound.Controls"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <controls:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <controls:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
            <controls:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <controls:MuteGlyphConverter x:Key="MuteGlyphConverter" />

            <!--
                Kills WPF's default keyboard-focus rectangle app-wide. It
                renders in the user's Windows accent color (gold/amber for
                some, blue for others) via SystemParameters, which is why
                the flyout showed stray colored lines under every slider and
                row — a real Quick Settings-style flyout shouldn't show
                focus rings at all.
            -->
            <Style TargetType="Control">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
